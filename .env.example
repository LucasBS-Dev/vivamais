# Copie para .env e defina senhas locais aleatórias. Nunca versionar .env.
# Docker Compose interpola estas variáveis. Maven NÃO lê este arquivo automaticamente.
POSTGRES_DB=vivamais
POSTGRES_USER=vivamais
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/vivamais
DATABASE_USER=vivamais
DATABASE_POOL_SIZE=4
PORT=8080
# Provisionamento sintético explícito: perfil bootstrap e senha >=12 caracteres.
DEMO_BOOTSTRAP_PASSWORD=
SPRING_PROFILES_ACTIVE=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# API_BASE_URL só no servidor Next; copiar também para apps/web/.env.local.
API_BASE_URL=http://127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:3000
# URL pública para builds; localhost só para desenvolvimento no mesmo computador.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Fases posteriores: sem chaves de fornecedores no cliente.
# SUPABASE_STORAGE_URL=              # Backend, F4
# SUPABASE_SERVICE_ROLE_KEY=         # Backend, F4; NUNCA NEXT_PUBLIC/EXPO_PUBLIC
# FOOD_ANALYSIS_ENABLED=false       # Bloqueado até aprovação clínica
# PERSONALIZED_ACTIVITY_ENABLED=false
# REAL_BRACELET_ENABLED=false
